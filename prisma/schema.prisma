generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model GitHubProfile {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  name          String?
  bio           String?
  followers     Int
  following     Int
  publicRepos   Int
  accountAge    Int?
  avatarUrl     String?
  profileUrl    String?
  location      String?
  createdAt     DateTime @default(now())
}